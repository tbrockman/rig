#!/usr/bin/env python3
"""
gpuctl - single-GPU arbitration for Incus VMs.

Enforces one invariant: at most one instance has the GPU device configured,
and it never moves away from a *running* instance.

State is never stored. Incus is the sole source of truth; everything here is
derived from `GET /1.0/instances`. The only persistent artefact is a lock file,
because "check then act" is a race and flock is the smallest thing that fixes
it.

It also refuses to start an instance with no network isolation, for the same
reason: an unisolated guest reaches this host's sshd and the whole LAN, and
nothing else notices.

Verbs:
    status              show who holds the GPU
    claim   <instance>  move the GPU to <instance>
    release             detach the GPU from whoever holds it
    start   <instance>  claim, then start
    stop    <instance>  stop (GPU stays attached to the stopped instance)

Config via environment:
    GPUCTL_PCI      PCI address, e.g. 0000:04:00.0   (required for claim)
    GPUCTL_DEVICE   device name on the instance      (default: gpu0)
    GPUCTL_ACL      required NIC isolation ACL       (default: vm-isolate)
    INCUS_SOCKET    default: /var/lib/incus/unix.socket
    GPUCTL_LOCK     default: /var/lock/gpuctl.lock
"""

import argparse
import fcntl
import http.client
import json
import os
import socket
import sys
from contextlib import contextmanager

SOCKET = os.environ.get("INCUS_SOCKET", "/var/lib/incus/unix.socket")
LOCKFILE = os.environ.get("GPUCTL_LOCK", "/var/lock/gpuctl.lock")
DEVICE = os.environ.get("GPUCTL_DEVICE", "gpu0")
PCI = os.environ.get("GPUCTL_PCI", "")
ACL = os.environ.get("GPUCTL_ACL", "vm-isolate")


class Fail(Exception):
    pass


# --------------------------------------------------------------------------
# Incus REST client (stdlib only, so this packages trivially with Nix)
# --------------------------------------------------------------------------

class UnixHTTPConnection(http.client.HTTPConnection):
    def __init__(self, path, timeout=60):
        super().__init__("localhost", timeout=timeout)
        self.unix_path = path

    def connect(self):
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(self.timeout)
        s.connect(self.unix_path)
        self.sock = s


def api(method, path, body=None, etag=None, timeout=60):
    """Returns (parsed_document, etag). Raises Fail on API errors."""
    conn = UnixHTTPConnection(SOCKET, timeout=timeout)
    headers = {"Content-Type": "application/json"}
    if etag:
        headers["If-Match"] = etag
    payload = json.dumps(body) if body is not None else None
    try:
        conn.request(method, path, payload, headers)
        resp = conn.getresponse()
        raw = resp.read()
        resp_etag = resp.getheader("ETag")
    except (FileNotFoundError, PermissionError) as e:
        raise Fail(f"cannot reach Incus at {SOCKET}: {e}")
    finally:
        conn.close()

    try:
        doc = json.loads(raw)
    except json.JSONDecodeError:
        raise Fail(f"non-JSON response from {path}: {raw[:200]!r}")

    if doc.get("type") == "error":
        raise Fail(f"incus: {doc.get('error')} (code {doc.get('error_code')})")
    return doc, resp_etag


def wait(doc, timeout=180):
    """Block on an async operation. Returns its metadata."""
    if doc.get("type") != "async":
        return doc.get("metadata")
    op = doc["operation"]
    res, _ = api("GET", f"{op}/wait?timeout={timeout}", timeout=timeout + 15)
    md = res.get("metadata") or {}
    if md.get("err"):
        raise Fail(f"operation failed: {md['err']}")
    if md.get("status_code", 0) >= 400:
        raise Fail(f"operation failed: {md.get('status')}")
    return md


# --------------------------------------------------------------------------
# Derived state
# --------------------------------------------------------------------------

def instances():
    doc, _ = api("GET", "/1.0/instances?recursion=1")
    return doc["metadata"]


def instance(name):
    doc, etag = api("GET", f"/1.0/instances/{name}")
    return doc["metadata"], etag


def gpu_devices(inst):
    """GPU devices defined directly on the instance (not via a profile)."""
    return {n: d for n, d in (inst.get("devices") or {}).items()
            if d.get("type") == "gpu"}


def profiles():
    doc, _ = api("GET", "/1.0/profiles?recursion=1")
    return doc["metadata"]


def check_no_profile_gpu(insts):
    """A GPU in a profile means every instance using it is configured to grab
    the same card. That is the double-attach condition, so refuse to operate at
    all until it is removed.

    Checked against the profiles themselves rather than against instances'
    expanded devices. An instance-level device of the same name (`gpu0`, which
    is exactly what this tool creates) masks the profile's copy, so scanning
    inherited devices reports all-clear while the profile stays primed to do
    damage to the next instance created — and misses a poisoned profile that no
    instance uses yet entirely.
    """
    for p in profiles():
        gpus = sorted(n for n, d in (p.get("devices") or {}).items()
                      if d.get("type") == "gpu")
        if not gpus:
            continue
        users = sorted(i["name"] for i in insts
                       if p["name"] in (i.get("profiles") or []))
        used = f" Currently used by: {', '.join(users)}." if users else ""
        raise Fail(
            f"profile {p['name']!r} defines GPU device(s) {', '.join(gpus)}."
            f"{used}\n"
            f"Every instance using this profile is configured to grab the same "
            f"card.\n"
            f"Remove it:  incus profile device remove {p['name']} {gpus[0]}"
        )


def isolation_report(inst):
    """(unisolated, no_egress) NIC names for one instance.

    unisolated  the NIC does not carry the isolation ACL, so the guest can
                reach this host and the LAN. Worth refusing to start over —
                it is the same class of failure as the silent hot-unplug:
                nothing looks wrong from the outside.
    no_egress   the ACL is attached but the egress default is not `allow`.
                Attaching any ACL makes Incus default to *reject* in both
                directions, which turns a denylist into a blackout. Broken
                rather than unsafe, so this only warns.

    Uses expanded_devices: the ACL is expected to come from a profile. That is
    the opposite of the GPU rule, and correct — every instance should have the
    same NIC policy, and no instance should have the same GPU.
    """
    unisolated, no_egress = [], []
    for name, dev in (inst.get("expanded_devices") or {}).items():
        if dev.get("type") != "nic":
            continue
        acls = [a.strip() for a in (dev.get("security.acls") or "").split(",")
                if a.strip()]
        if ACL not in acls:
            unisolated.append(name)
        elif dev.get("security.acls.default.egress.action") != "allow":
            no_egress.append(name)
    return unisolated, no_egress


def find_holders(insts):
    out = []
    for i in insts:
        for n, d in gpu_devices(i).items():
            out.append({"instance": i["name"], "device": n,
                        "status": i["status"], "pci": d.get("pci", "?")})
    return out


def set_devices(name, devices):
    """Round-trip PUT with ETag, the same optimistic-concurrency dance the CLI
    does. flock protects against our own concurrency; the ETag catches anyone
    editing the instance out of band."""
    inst, etag = instance(name)
    body = {
        "architecture": inst.get("architecture"),
        "config": inst.get("config") or {},
        "devices": devices,
        "ephemeral": inst.get("ephemeral", False),
        "profiles": inst.get("profiles") or [],
        "description": inst.get("description", ""),
    }
    doc, _ = api("PUT", f"/1.0/instances/{name}", body, etag=etag)
    wait(doc)


def set_state(name, action, timeout=120):
    doc, _ = api("PUT", f"/1.0/instances/{name}/state",
                 {"action": action, "timeout": timeout},
                 timeout=timeout + 15)
    wait(doc, timeout=timeout)


@contextmanager
def locked():
    os.makedirs(os.path.dirname(LOCKFILE), exist_ok=True)
    fd = os.open(LOCKFILE, os.O_CREAT | os.O_RDWR, 0o664)
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            print("waiting for gpuctl lock...", file=sys.stderr)
            fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        fcntl.flock(fd, fcntl.LOCK_UN)
        os.close(fd)


# --------------------------------------------------------------------------
# Commands
# --------------------------------------------------------------------------

def cmd_status(args):
    insts = instances()
    check_no_profile_gpu(insts)
    holders = find_holders(insts)

    if args.json:
        print(json.dumps({
            "holders": holders,
            "instances": [{"name": i["name"], "status": i["status"],
                           "isolated": not isolation_report(i)[0]}
                          for i in insts],
        }, indent=2))
        return

    if not holders:
        print("GPU is unassigned.")
    elif len(holders) > 1:
        print("!! GPU device is configured on MULTIPLE instances:")
        for h in holders:
            print(f"   {h['instance']:<20} {h['status']:<10} {h['pci']}")
        print("   Starting a second one will hot-unplug the card from the")
        print("   first. Fix with: gpuctl release && gpuctl claim <instance>")
    else:
        h = holders[0]
        print(f"GPU held by {h['instance']} ({h['status']}) at {h['pci']}")

    print()
    for i in sorted(insts, key=lambda x: x["name"]):
        mark = "*" if any(h["instance"] == i["name"] for h in holders) else " "
        unisolated, no_egress = isolation_report(i)
        note = ""
        if unisolated:
            note = f"  !! NO ISOLATION on {', '.join(sorted(unisolated))}"
        elif no_egress:
            note = f"  !! no egress on {', '.join(sorted(no_egress))}"
        print(f" {mark} {i['name']:<20} {i['status']:<10}{note}")


def cmd_claim(args):
    if not PCI:
        raise Fail("GPUCTL_PCI is not set (e.g. export GPUCTL_PCI=0000:04:00.0)")

    with locked():
        insts = instances()
        check_no_profile_gpu(insts)

        names = {i["name"]: i for i in insts}
        if args.instance not in names:
            raise Fail(f"no such instance: {args.instance}")
        target = names[args.instance]
        holders = find_holders(insts)

        if len(holders) > 1:
            raise Fail("GPU is configured on multiple instances; "
                       "run `gpuctl release` first")

        # Already correct?
        if holders and holders[0]["instance"] == args.instance:
            print(f"{args.instance} already holds the GPU.")
            return

        # Refuse to take it from a running instance. This is the whole point.
        if holders and holders[0]["status"] == "Running":
            raise Fail(
                f"GPU is held by {holders[0]['instance']}, which is RUNNING.\n"
                f"Detaching it would hot-unplug the card from a live workload.\n"
                f"Stop it first:  gpuctl stop {holders[0]['instance']}"
            )

        # GPU devices are not hotpluggable for VMs.
        if target["status"] == "Running":
            raise Fail(
                f"{args.instance} is running; GPU devices cannot be hotplugged "
                f"into a VM.\nStop it first:  gpuctl stop {args.instance}"
            )

        if holders:
            prev = holders[0]
            inst, _ = instance(prev["instance"])
            devs = dict(inst.get("devices") or {})
            devs.pop(prev["device"], None)
            set_devices(prev["instance"], devs)
            print(f"detached GPU from {prev['instance']}")

        inst, _ = instance(args.instance)
        devs = dict(inst.get("devices") or {})
        devs[DEVICE] = {"type": "gpu", "gputype": "physical", "pci": PCI}
        set_devices(args.instance, devs)
        print(f"attached GPU ({PCI}) to {args.instance}")


def cmd_release(args):
    with locked():
        insts = instances()
        holders = find_holders(insts)
        if not holders:
            print("GPU is already unassigned.")
            return
        for h in holders:
            if h["status"] == "Running" and not args.force:
                raise Fail(
                    f"{h['instance']} is RUNNING. Stop it first, or pass "
                    f"--force to hot-unplug (this WILL break its workload)."
                )
        for h in holders:
            inst, _ = instance(h["instance"])
            devs = dict(inst.get("devices") or {})
            devs.pop(h["device"], None)
            set_devices(h["instance"], devs)
            print(f"detached GPU from {h['instance']}")


def cmd_start(args):
    # Checked before the claim so a refusal does not leave the GPU moved.
    inst, _ = instance(args.instance)
    unisolated, no_egress = isolation_report(inst)
    if unisolated and not args.allow_unisolated:
        nics = ", ".join(sorted(unisolated))
        raise Fail(
            f"{args.instance} has no network isolation: NIC {nics} does not "
            f"carry the {ACL!r} ACL.\n"
            f"An unisolated guest reaches this host's sshd on every address the "
            f"host holds, plus the LAN and the tailnet.\n"
            f"Fix it for every instance:\n"
            f"  incus profile device set default eth0 security.acls={ACL} \\\n"
            f"    security.acls.default.egress.action=allow \\\n"
            f"    security.acls.default.ingress.action=reject\n"
            f"Then verify:  ./test-network-acl.sh {args.instance}\n"
            f"To start anyway:  gpuctl start --allow-unisolated "
            f"{args.instance}"
        )
    for nic in sorted(no_egress):
        print(f"warning: NIC {nic} has {ACL} attached but its egress default "
              f"is not 'allow'. Attaching an ACL makes Incus default to "
              f"reject, so this guest will have no internet at all.",
              file=sys.stderr)

    cmd_claim(args)
    with locked():
        inst, _ = instance(args.instance)
        if inst["status"] == "Running":
            print(f"{args.instance} already running.")
            return
        set_state(args.instance, "start")
        print(f"started {args.instance}")


def cmd_stop(args):
    with locked():
        inst, _ = instance(args.instance)
        if inst["status"] == "Stopped":
            print(f"{args.instance} already stopped.")
            return
        set_state(args.instance, "stop")
        print(f"stopped {args.instance} (GPU still attached to it)")


def main():
    p = argparse.ArgumentParser(prog="gpuctl", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("status");  s.add_argument("--json", action="store_true")
    s.set_defaults(func=cmd_status)

    s = sub.add_parser("claim");   s.add_argument("instance")
    s.set_defaults(func=cmd_claim)

    s = sub.add_parser("release"); s.add_argument("--force", action="store_true")
    s.set_defaults(func=cmd_release)

    s = sub.add_parser("start");   s.add_argument("instance")
    s.add_argument("--allow-unisolated", action="store_true",
                   help="start even if the NIC has no isolation ACL")
    s.set_defaults(func=cmd_start)

    s = sub.add_parser("stop");    s.add_argument("instance")
    s.set_defaults(func=cmd_stop)

    args = p.parse_args()
    try:
        args.func(args)
    except Fail as e:
        print(f"error: {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
